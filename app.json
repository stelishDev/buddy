{
  "expo": {
    "name": "Eaves",
    "slug": "eaves",
    "scheme": "eaves",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talspot.eaves",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Eaves converts meeting audio to text so it can take notes and answer questions.",
        "NSMicrophoneUsageDescription": "Eaves listens to your meeting so it can transcribe it and take notes."
      }
    },
    "android": {
      "package": "com.talspot.eaves",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Eaves listens to your meeting so it can transcribe it and take notes.",
          "speechRecognitionPermission": "Eaves converts meeting audio to text so it can take notes and answer questions.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "EavesWidget",
              "displayName": "Eaves",
              "description": "Your latest meeting's summary and open action items.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
                "initialLayout": "src/widgets/EavesWidget.ios.tsx"
              },
              "android": {
                "minWidth": 250,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "src/widgets/EavesWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b28460b5-e20a-4c97-bd47-25192eb9c72d"
      }
    },
    "owner": "stelish",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b28460b5-e20a-4c97-bd47-25192eb9c72d"
    }
  }
}
