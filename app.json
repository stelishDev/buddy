{
  "expo": {
    "name": "MeMate",
    "slug": "memate",
    "scheme": "memate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.talspot.memate"
    },
    "android": {
      "package": "com.talspot.memate",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MeMate listens to your meeting so it can transcribe it and take notes.",
          "speechRecognitionPermission": "MeMate converts meeting audio to text so it can take notes and answer questions.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
